# Copy to .env and fill in before running `docker compose up`.

# --- Core ---
ENVIRONMENT=production
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:8080"]

# --- Data stores (defaults match docker-compose.yml service names) ---
DATABASE_URL=postgresql+psycopg://corella:corella@postgres:5432/corella
POSTGRES_USER=corella
POSTGRES_PASSWORD=corella
POSTGRES_DB=corella
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- Speech models (worker) ---
# Required to download the gated pyannote speaker-diarization pipeline from
# Hugging Face: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# --- Audio storage ---
AUDIO_STORAGE_PATH=/data/audio

# --- LLM providers (all optional — configure per-user in Settings instead;
# these only serve as instance-wide fallbacks) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

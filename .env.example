# Copy to .env and fill in before running `docker compose up`.

# --- Core ---
ENVIRONMENT=production
JWT_SECRET=change-me-to-a-long-random-string

# Host-side published ports (docker-compose.yml). Containers still listen
# on 8000 (api) and 80 (web). Defaults: 8090 / 8080. Change these if they
# collide on the host — then keep CORS_ORIGINS / PUBLIC_APP_URL (and
# PUBLIC_API_URL, if you set it) pointing at the matching origins.
API_PORT=8090
WEB_PORT=8080

CORS_ORIGINS=["http://localhost:8080"]
# Where the built frontend looks for the api. Unset, docker-compose.yml
# defaults this to http://localhost:${API_PORT}. Set it explicitly when
# the browser-facing API origin is not that (a reverse proxy, a public
# hostname). Vite bakes this in at build time, so changing it requires
# `docker compose build web` again, not just a restart.
PUBLIC_API_URL=http://localhost:8090

# This instance's own public URL — sent as the X-Corella-App-Url header on
# every pre/post call-type API hook (see API.md), so a receiving system
# can tell which Corella deployment a request came from. Not the same
# direction as PUBLIC_API_URL above (that's "which API the browser talks
# to"; this is "what URL identifies us to someone else"). Must match the
# browser origin (WEB_PORT above, unless you've put a hostname in front).
PUBLIC_APP_URL=http://localhost:8080

# --- Access control ---
# true  = anyone can create their own account via /api/auth/register.
#         Signup also creates "{full_name} Org" with that user as owner,
#         and they may create more orgs up to MAX_ORGS_PER_USER (owned
#         orgs, not memberships).
# false = no self-serve signup and no self-serve org create. Bootstrap
#         ADMIN_EMAIL is super_admin and owner of one instance org.
#         Invited / admin-created users join that org as members.
# Flipping the flag later does not merge or split orgs.
ALLOW_PUBLIC_REGISTRATION=true
MAX_ORGS_PER_USER=1
INVITE_EXPIRE_DAYS=7

# Optional — Resend transactional email for org invite links. Copy-link still
# works without these. Both must be set to actually send; from_email must be
# a domain you've verified in Resend. A send failure never fails the invite.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Bootstrap super-admin account, created automatically on first startup
# if it doesn't already exist. Required (set both) if you're turning off
# public registration. Changing these after the account already exists
# does NOT update it — rotate the password through the app instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin

# --- Data stores (defaults match docker-compose.yml service names) ---
DATABASE_URL=postgresql+psycopg://corella:corella@postgres:5432/corella
POSTGRES_USER=corella
POSTGRES_PASSWORD=corella
POSTGRES_DB=corella
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- Speech models (worker) ---
# Required to download the gated pyannote speaker-diarization pipeline from
# Hugging Face: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# Optional cloud speech-to-text — local faster-whisper above is always the
# zero-config default either way; setting this (or a user saving their own
# key in Settings) switches both live and uploaded transcription to
# Deepgram whenever it's reachable, falling back to local automatically if
# it isn't. Same instance-wide-fallback pattern as the LLM providers below.
DEEPGRAM_API_KEY=
DEFAULT_MODEL_DEEPGRAM=nova-3

# --- Audio storage ---
AUDIO_STORAGE_PATH=/data/audio
MAX_AUDIO_UPLOAD_MB=500

# --- Knowledge base document storage ---
KB_STORAGE_PATH=/data/kb
MAX_KB_UPLOAD_MB=50
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM providers (all optional — configure per-user in Settings instead;
# these only serve as instance-wide fallbacks, and Settings reports a
# provider "connected" purely based on one of these being non-empty) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# No Ollama service is included in docker-compose.yml by default — only set
# this if you're running your own, e.g. http://ollama:11434 for one added
# as a compose service, or http://host.docker.internal:11434 for one
# running on the host.
OLLAMA_BASE_URL=

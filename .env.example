# Copy to .env and fill in before running `docker compose up`.

# --- Core ---
ENVIRONMENT=production
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://localhost:8080"]

# --- Access control ---
# true  = anyone can create their own account via /api/auth/register (default)
# false = self-serve registration is disabled; only an admin can create
#         accounts (via POST /api/admin/users). Set this to false for
#         admin-managed teams.
ALLOW_PUBLIC_REGISTRATION=true

# Bootstrap admin account, created automatically on first startup if it
# doesn't already exist. Required (set both) if you're turning off public
# registration, since accounts are no longer auto-promoted to admin.
# Changing these after the account already exists does NOT update it —
# rotate the password through the app instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Admin

# --- Data stores (defaults match docker-compose.yml service names) ---
DATABASE_URL=postgresql+psycopg://corella:corella@postgres:5432/corella
POSTGRES_USER=corella
POSTGRES_PASSWORD=corella
POSTGRES_DB=corella
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- Speech models (worker) ---
# Required to download the gated pyannote speaker-diarization pipeline from
# Hugging Face: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8

# --- Audio storage ---
AUDIO_STORAGE_PATH=/data/audio
MAX_AUDIO_UPLOAD_MB=500

# --- LLM providers (all optional — configure per-user in Settings instead;
# these only serve as instance-wide fallbacks) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

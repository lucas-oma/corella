# Worker image for the ASR / diarization / embedding background jobs
# (app/workers). Heavier than the API image — pulls in faster-whisper,
# pyannote.audio and sentence-transformers (and transitively, torch).
FROM python:3.11-slim

WORKDIR /srv

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev build-essential ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY app ./app
# PyPI's default `torch` wheel bundles ~8GB of NVIDIA CUDA libraries even for
# a CPU-only install. This project's default deployment target is CPU-only
# (see docker-compose.gpu.yml for the opt-in GPU override), so resolve
# torch/torchaudio from PyTorch's CPU-only index instead — everything else
# still comes from PyPI via --extra-index-url.
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    -e ".[worker]"

# --concurrency pinned rather than left at Celery's default (os.cpu_count()):
# each forked worker process loads its own full copy of pyannote/whisper into
# memory and is now eagerly pre-warmed at startup (celery_app.py's
# worker_process_init hook) — on a multi-core host, an uncapped process count
# means several independent cold-load-then-idle copies. 2 trades some
# task-level parallelism for a predictable, bounded memory footprint and
# fully-warm latency on a CPU-only deployment; raise it if the host has
# cores/RAM to spare and genuinely needs more concurrent heavy jobs.
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
